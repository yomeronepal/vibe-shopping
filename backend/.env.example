# ===================================
# Django Settings
# ===================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# ===================================
# Database Configuration
# ===================================
DB_NAME=vibe_shopping_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ===================================
# Redis & Celery Configuration
# ===================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# ===================================
# CORS Configuration
# ===================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================================
# Multi-Tenancy Configuration
# ===================================
# Base domain for tenant subdomains (e.g., tenant.yourdomain.com)
TENANT_BASE_DOMAIN=localhost:8000

# ===================================
# Google Gemini AI Configuration
# ===================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-gemini-api-key-here

# ===================================
# Social Media OAuth Credentials
# ===================================
# Instagram/Facebook OAuth (Meta App)
# Register at: https://developers.facebook.com/apps/
# Required permissions: instagram_basic, instagram_content_publish, pages_read_engagement, pages_manage_posts
INSTAGRAM_APP_ID='1002363479616209'
INSTAGRAM_APP_SECRET='77fd0d05dfa5301852e316d4fb7ce938'

# Facebook OAuth (Optional - uses Instagram credentials if not set)
FACEBOOK_APP_ID='1002363479616209'
FACEBOOK_APP_SECRET='77fd0d05dfa5301852e316d4fb7ce938'

# TikTok OAuth
# Register at: https://developers.tiktok.com/
# Required scopes: user.info.basic, video.upload
TIKTOK_CLIENT_KEY=your-tiktok-client-key-here
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret-here

# ===================================
# Email Configuration (Optional - for production)
# ===================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@vibeshopping.com

# ===================================
# AWS S3 Configuration (Optional - for production media storage)
# ===================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# USE_S3=False

# ===================================
# Stripe Configuration (Optional - for payments)
# ===================================
# STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
